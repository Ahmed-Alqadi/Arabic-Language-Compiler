// مثال 17: مشروع متكامل يجمع المصفوفات والسجلات والدوال والشروط
برنامج نظام_تقييم_الطلاب؛
{
    نوع مصفوفة_درجات = قائمة [ 3 ] من صحيح؛
    نوع سجل_نتيجة = سجل {
        رقم_الجلوس: صحيح؛
        مجموع: صحيح؛
        معدل: حقيقي؛
    }؛

    متغير درجات: مصفوفة_درجات؛
    متغير نتيجة_الطالب: سجل_نتيجة؛
    متغير ف: صحيح؛

    إجراء حساب_النتيجة(بالقيمة د1: صحيح؛ بالقيمة د2: صحيح؛ بالقيمة د3: صحيح؛ بالمرجع اجمالي: صحيح؛ بالمرجع معدل: حقيقي)؛
    {
        اجمالي = د1 + د2 + د3؛
        معدل = اجمالي / 3.0؛
    }؛

    درجات[0] = 85؛
    درجات[1] = 92؛
    درجات[2] = 78؛

    نتيجة_الطالب.رقم_الجلوس = 5520؛
    نتيجة_الطالب.مجموع = 0؛
    نتيجة_الطالب.معدل = 0.0؛

    حساب_النتيجة(درجات[0]، درجات[1]، درجات[2]، نتيجة_الطالب.مجموع، نتيجة_الطالب.معدل)؛

    اطبع("=== كشف درجات الطالب الجامعي ===")؛
    اطبع("رقم الجلوس:")؛
    اطبع(نتيجة_الطالب.رقم_الجلوس)؛

    اطبع("درجات المواد الثلاث:")؛
    ف = 0؛
    طالما (ف < 3) استمر {
        اطبع(درجات[ف])؛
        ف = ف + 1؛
    }

    اطبع("المجموع الكلي للدرجات:")؛
    اطبع(نتيجة_الطالب.مجموع)؛
    اطبع("المعدل التراكمي:")؛
    اطبع(نتيجة_الطالب.معدل)؛

    إذا (نتيجة_الطالب.معدل >= 90.0) فإن {
        اطبع("التقدير العام: ممتاز (مرتبة الشرف)")؛
    } وإلا {
        إذا (نتيجة_الطالب.معدل >= 80.0) فإن {
            اطبع("التقدير العام: جيد جداً")؛
        } وإلا {
            إذا (نتيجة_الطالب.معدل >= 65.0) فإن {
                اطبع("التقدير العام: جيد")؛
            } وإلا {
                اطبع("التقدير العام: مقبول")؛
            }
        }
    }
}.
