برنامج العمليات_الحسابية؛
{
    متغير أ، ب، قوة، باقي_قسمة: صحيح؛
    متغير قسمة_حقيقية: حقيقي؛
    أ = 2؛
    ب = 3؛
    قوة = أ ^ ب؛
    باقي_قسمة = 17 % 5؛
    قسمة_حقيقية = 10 / 4؛
    اطبع("2 أس 3 =")؛
    اطبع(قوة)؛
    اطبع("باقي 17 على 5 =")؛
    اطبع(باقي_قسمة)؛
    اطبع("قسمة 10 على 4 =")؛
    اطبع(قسمة_حقيقية)؛
}.
