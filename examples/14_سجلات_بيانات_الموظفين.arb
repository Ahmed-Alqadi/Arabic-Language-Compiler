// مثال 14: سجلات وهياكل بيانات الموظفين وحساب الرواتب
برنامج بيانات_الموظفين؛
{
    نوع سجل_موظف = سجل {
        رقم: صحيح؛
        راتب: حقيقي؛
        بدل: حقيقي؛
        خصم: حقيقي؛
        صافي: حقيقي؛
    }؛

    متغير موظف1: سجل_موظف؛
    متغير موظف2: سجل_موظف؛

    موظف1.رقم = 1001؛
    موظف1.راتب = 4500.0؛
    موظف1.بدل = 500.0؛
    موظف1.خصم = 150.0؛
    موظف1.صافي = موظف1.راتب + موظف1.بدل - موظف1.خصم؛

    موظف2.رقم = 1002؛
    موظف2.راتب = 6000.0؛
    موظف2.بدل = 800.0؛
    موظف2.خصم = 200.0؛
    موظف2.صافي = موظف2.راتب + موظف2.بدل - موظف2.خصم؛

    اطبع("=== قسيمة راتب الموظف الأول ===")؛
    اطبع("الرقم الوظيفي:")؛
    اطبع(موظف1.رقم)؛
    اطبع("صافي الراتب المستحق:")؛
    اطبع(موظف1.صافي)؛

    اطبع("=== قسيمة راتب الموظف الثاني ===")؛
    اطبع("الرقم الوظيفي:")؛
    اطبع(موظف2.رقم)؛
    اطبع("صافي الراتب المستحق:")؛
    اطبع(موظف2.صافي)؛

    إذا (موظف2.صافي > موظف1.صافي) فإن {
        اطبع("الموظف الثاني لديه صافي راتب أعلى.")؛
    } وإلا {
        اطبع("الموظف الأول لديه صافي راتب أعلى.")؛
    }
}.
