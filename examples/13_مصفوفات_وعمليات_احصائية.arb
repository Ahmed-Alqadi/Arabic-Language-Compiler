// مثال 13: مصفوفات وعمليات إحصائية (المجموع، المتوسط، أكبر قيمة)
برنامج احصاء_المصفوفات؛
{
    نوع قائمة_ارقام = قائمة [ 5 ] من صحيح؛
    متغير اعداد: قائمة_ارقام؛
    متغير فهرس، مجموع، اكبر: صحيح؛
    متغير معدل: حقيقي؛

    اعداد[0] = 15؛
    اعداد[1] = 25؛
    اعداد[2] = 40؛
    اعداد[3] = 10؛
    اعداد[4] = 30؛

    فهرس = 0؛
    مجموع = 0؛
    اكبر = اعداد[0]؛

    طالما (فهرس < 5) استمر {
        مجموع = مجموع + اعداد[فهرس]؛
        إذا (اعداد[فهرس] > اكبر) فإن {
            اكبر = اعداد[فهرس]؛
        }
        فهرس = فهرس + 1؛
    }

    معدل = مجموع / 5.0؛

    اطبع("عناصر المصفوفة:")؛
    اطبع("15، 25، 40، 10، 30")؛
    اطبع("مجموع العناصر =")؛
    اطبع(مجموع)؛
    اطبع("المعدل الحسابي =")؛
    اطبع(معدل)؛
    اطبع("اكبر قيمة في المصفوفة =")؛
    اطبع(اكبر)؛
}.
