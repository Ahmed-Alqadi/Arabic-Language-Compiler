// مثال 16: دوال وإجراءات رياضية بمعاملات بالقيمة وبالمرجع
برنامج دوال_ورياضيات؛
{
    متغير عدد، مربع_العدد: صحيح؛
    متغير نق: حقيقي؛
    متغير محيط_الدائرة: حقيقي؛
    متغير س، ص، مؤقت: صحيح؛

    إجراء احسب_المربع(بالقيمة ن: صحيح؛ بالمرجع نتيجة: صحيح)؛
    {
        نتيجة = ن * ن؛
    }؛

    إجراء احسب_محيط_الدائرة(بالقيمة ر: حقيقي؛ بالمرجع محيط: حقيقي)؛
    {
        محيط = 2.0 * 3.14159 * ر؛
    }؛

    إجراء تبديل_قيمتين(بالمرجع الأول: صحيح؛ بالمرجع الثاني: صحيح)؛
    {
        مؤقت = الأول؛
        الأول = الثاني؛
        الثاني = مؤقت؛
    }؛

    عدد = 9؛
    مربع_العدد = 0؛
    احسب_المربع(عدد، مربع_العدد)؛
    اطبع("مربع العدد 9 =")؛
    اطبع(مربع_العدد)؛

    نق = 5.0؛
    محيط_الدائرة = 0.0؛
    احسب_محيط_الدائرة(نق، محيط_الدائرة)؛
    اطبع("محيط الدائرة لنصف القطر 5.0 =")؛
    اطبع(محيط_الدائرة)؛

    س = 10؛
    ص = 20؛
    اطبع("القيم قبل التبديل: س = 10 ، ص = 20")؛
    تبديل_قيمتين(س، ص)؛
    اطبع("قيمة س بعد التبديل =")؛
    اطبع(س)؛
    اطبع("قيمة ص بعد التبديل =")؛
    اطبع(ص)؛
}.
